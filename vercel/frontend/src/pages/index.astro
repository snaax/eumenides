---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Postez sans regrets" description="Eumenides intercepte vos posts impulsifs sur les réseaux sociaux avant qu'il ne soit trop tard. Transformez votre rage en sagesse." darkBg={true}>
  <Nav />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <div class="hero-badge">🛡️ Extension Chrome gratuite</div>
      <h1>Postez sans <span class="gradient-text">regrets</span></h1>
      <p class="hero-sub">Eumenides intercepte vos posts impulsifs avant qu'il ne soit trop tard.<br />Transformez votre rage en sagesse.</p>
      <div class="hero-cta">
        <a href="#" id="install-btn" class="btn-primary">✨ Commencer gratuitement</a>
        <a href="#how-it-works" class="btn-secondary">Voir comment ça marche</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><span>5</span> posts/jour gratuits</div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat"><span>4</span> plateformes</div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat"><span>100%</span> regrets évités</div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <h2>3 modes de protection</h2>
        <p>Choisissez comment Eumenides vous protège de vous-même</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Catharsis instantanée</h3>
          <p>Le post semble envoyé, mais ne l'est pas vraiment. Vous obtenez la satisfaction émotionnelle sans les conséquences réelles.</p>
          <div class="feature-badge free">Gratuit</div>
        </div>
        <div class="feature-card">
          <div class="feature-icon">👁️</div>
          <h3>Aperçu privé</h3>
          <p>Visualisez exactement ce que vos followers verront. Prenez le temps de décider si vous voulez vraiment poster ça.</p>
          <div class="feature-badge free">Gratuit</div>
        </div>
        <div class="feature-card featured-card">
          <div class="feature-icon">⏰</div>
          <h3>Délai de réflexion</h3>
          <p>Votre post est sauvegardé. Eumenides vous re-contacte dans 6 heures pour vous demander si vous voulez toujours l'envoyer.</p>
          <div class="feature-badge premium">Premium</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section-dark" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <h2>Comment ça marche ?</h2>
        <p>En 4 étapes simples, Eumenides protège vos relations en ligne</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Installez l'extension</h3>
            <p>Ajoutez Eumenides à Chrome en un clic. Aucune configuration requise.</p>
          </div>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Rédigez votre post</h3>
            <p>Sur Twitter/X, Facebook, Reddit ou LinkedIn — écrivez normalement.</p>
          </div>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Eumenides intervient</h3>
            <p>Quand vous cliquez sur "Publier", notre détection émotionnelle s'active.</p>
          </div>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>Vous décidez</h3>
            <p>Annuler, prévisualiser, ou attendre. Le choix final vous appartient toujours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Fonctionne sur vos plateformes</h2>
        <p>Eumenides vous protège partout où vous postez</p>
      </div>
      <div class="platforms">
        <div class="platform-item">
          <span class="platform-icon">𝕏</span>
          <span>Twitter / X</span>
        </div>
        <div class="platform-item">
          <span class="platform-icon">f</span>
          <span>Facebook</span>
        </div>
        <div class="platform-item">
          <span class="platform-icon">in</span>
          <span>LinkedIn</span>
        </div>
        <div class="platform-item">
          <span class="platform-icon">👽</span>
          <span>Reddit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing preview -->
  <section class="section section-dark" id="pricing-preview">
    <div class="container">
      <div class="section-header">
        <h2>Simple et transparent</h2>
        <p>Commencez gratuitement, passez à Premium quand vous voulez</p>
      </div>
      <div class="pricing-preview-grid">
        <div class="pricing-preview-card">
          <div class="pp-badge">🆓 Gratuit</div>
          <div class="pp-price">0€ <span>/mois</span></div>
          <ul>
            <li>✓ 5 posts par jour</li>
            <li>✓ X et Reddit</li>
            <li>✓ Modes Catharsis et Aperçu</li>
          </ul>
          <a href="#" class="btn-secondary install-btn" style="display:block;text-align:center;margin-top:20px;">Commencer</a>
        </div>
        <div class="pricing-preview-card">
          <div class="pp-badge pp-badge-basic">✨ Basic</div>
          <div class="pp-price">1,99€ <span>/mois</span></div>
          <ul>
            <li>✓ 15 posts par jour</li>
            <li>✓ X, Reddit, Facebook</li>
            <li>✓ Mode Délai</li>
            <li>✓ Dashboard basique</li>
          </ul>
          <a href="/subscribe?plan=basic" class="btn-secondary" style="display:block;text-align:center;margin-top:20px;">Passer à Basic</a>
        </div>
        <div class="pricing-preview-card pp-featured">
          <div class="pp-badge pp-badge-full">⭐ Full — Recommandé</div>
          <div class="pp-price">4,99€ <span>/mois</span></div>
          <ul>
            <li>✓ Posts illimités</li>
            <li>✓ Toutes les plateformes</li>
            <li>✓ Mode Délai personnalisable</li>
            <li>✓ Dashboard complet</li>
            <li>✓ Synchronisation cloud</li>
          </ul>
          <a href="/subscribe?plan=full" class="btn-primary" style="display:block;text-align:center;margin-top:20px;">Passer à Full</a>
        </div>
      </div>
      <div style="text-align:center;margin-top:24px;">
        <a href="/pricing" style="color:rgba(255,255,255,0.6);font-size:14px;text-decoration:underline;">Comparer tous les plans en détail →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-container">
      <div class="section-header">
        <h2>Questions fréquentes</h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <div class="faq-q">💳 Comment fonctionne le paiement ?</div>
          <div class="faq-a">Paiement sécurisé par carte bancaire via Stripe. L'abonnement se renouvelle automatiquement chaque mois mais vous pouvez annuler à tout moment.</div>
        </div>
        <div class="faq-item">
          <div class="faq-q">🔄 Puis-je annuler à tout moment ?</div>
          <div class="faq-a">Oui, absolument. Pas d'engagement, pas de frais cachés. Annulez en un clic depuis votre compte.</div>
        </div>
        <div class="faq-item">
          <div class="faq-q">🔒 Mes posts sont-ils lus par Eumenides ?</div>
          <div class="faq-a">Non. L'analyse émotionnelle se fait en local dans votre navigateur. Nous ne lisons jamais le contenu de vos posts et ne les stockons pas.</div>
        </div>
        <div class="faq-item">
          <div class="faq-q">📱 Fonctionne sur mobile ?</div>
          <div class="faq-a">Eumenides fonctionne sur Chrome desktop (Windows, Mac, Linux). Une version mobile est en développement.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="cta-section">
    <div class="container" style="text-align:center;">
      <h2>Prêt à poster sans regrets ?</h2>
      <p>Rejoignez des milliers d'utilisateurs qui protègent leur réputation en ligne.</p>
      <a href="#" id="install-btn-cta" class="btn-primary install-btn" style="font-size:18px;padding:18px 48px;">✨ Commencer gratuitement</a>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const CHROME_STORE_URL = 'https://chrome.google.com/webstore/detail/eumenides/TODO_CHROME_ID';
  const FIREFOX_STORE_URL = 'https://addons.mozilla.org/fr/firefox/addon/eumenides/';

  const isFirefox = navigator.userAgent.includes('Firefox');
  const storeUrl = isFirefox ? FIREFOX_STORE_URL : CHROME_STORE_URL;

  document.querySelectorAll('.install-btn').forEach(btn => {
    (btn as HTMLAnchorElement).href = storeUrl;
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 120px 0 100px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 0%, rgba(102,126,234,0.3) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 80%, rgba(118,75,162,0.25) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(102,126,234,0.2);
    border: 1px solid rgba(102,126,234,0.4);
    color: #a5b4fc;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 28px;
  }

  h1 {
    font-size: clamp(42px, 7vw, 80px);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    color: #fff;
  }

  .gradient-text {
    background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 20px;
    line-height: 1.7;
    color: rgba(255,255,255,0.75);
    max-width: 580px;
    margin: 0 auto 40px;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    color: rgba(255,255,255,0.6);
    font-size: 14px;
  }

  .hero-stat span {
    font-size: 20px;
    font-weight: 700;
    color: #ffd700;
    margin-right: 4px;
  }

  .hero-stat-divider {
    width: 1px;
    height: 20px;
    background: rgba(255,255,255,0.2);
  }

  /* Sections */
  .section {
    padding: 80px 0;
  }

  .section-dark {
    background: rgba(0,0,0,0.25);
  }

  .section-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .section-header h2 {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 14px;
    color: #fff;
  }

  .section-header p {
    font-size: 17px;
    color: rgba(255,255,255,0.65);
  }

  /* Features */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .feature-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 36px 28px;
    transition: 0.3s;
    position: relative;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,215,0,0.3);
    box-shadow: 0 16px 48px rgba(102,126,234,0.2);
  }

  .featured-card {
    border-color: rgba(255,215,0,0.4);
    background: rgba(255,215,0,0.05);
  }

  .feature-icon {
    font-size: 42px;
    margin-bottom: 18px;
  }

  .feature-card h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
    color: #fff;
  }

  .feature-card p {
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
  }

  .feature-badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
  }

  .feature-badge.free {
    background: rgba(74,222,128,0.15);
    color: #4ade80;
    border: 1px solid rgba(74,222,128,0.3);
  }

  .feature-badge.premium {
    background: rgba(255,215,0,0.15);
    color: #ffd700;
    border: 1px solid rgba(255,215,0,0.3);
  }

  /* How it works */
  .steps {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .step {
    flex: 1;
    min-width: 180px;
    max-width: 220px;
    text-align: center;
  }

  .step-number {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 700;
    margin: 0 auto 16px;
  }

  .step-content h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #fff;
  }

  .step-content p {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
  }

  .step-arrow {
    font-size: 24px;
    color: rgba(255,255,255,0.3);
    margin-top: 16px;
    flex-shrink: 0;
  }

  /* Platforms */
  .platforms {
    display: flex;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .platform-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 20px 32px;
    font-size: 18px;
    font-weight: 600;
    transition: 0.2s;
  }

  .platform-item:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,215,0,0.3);
  }

  .platform-icon {
    font-size: 28px;
    font-weight: 900;
  }

  /* Pricing preview */
  .pricing-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .pricing-preview-card {
    background: rgba(255,255,255,0.05);
    border: 1.5px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    padding: 32px 24px;
  }

  .pp-featured {
    border-color: rgba(255,215,0,0.5);
    background: rgba(255,215,0,0.04);
    position: relative;
    overflow: hidden;
  }

  .pp-featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ffd700, #ffed4e, #ffd700);
  }

  .pp-badge {
    display: inline-block;
    background: rgba(255,255,255,0.1);
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .pp-badge-full {
    background: linear-gradient(135deg, rgba(255,215,0,0.2), rgba(255,237,78,0.2));
    color: #ffd700;
  }

  .pp-badge-basic {
    background: rgba(102,126,234,0.2);
    color: #a5b4fc;
  }

  .pp-price {
    font-size: 42px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 20px;
  }

  .pp-price span {
    font-size: 16px;
    color: rgba(255,255,255,0.5);
    font-weight: 400;
  }

  .pricing-preview-card ul {
    list-style: none;
    padding: 0;
    margin-bottom: 8px;
  }

  .pricing-preview-card li {
    font-size: 14px;
    color: rgba(255,255,255,0.8);
    padding: 7px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .pricing-preview-card li:last-child {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    max-width: 720px;
  }

  .faq-list {
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .faq-item {
    padding: 24px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .faq-q {
    font-size: 17px;
    font-weight: 600;
    color: #ffd700;
    margin-bottom: 10px;
  }

  .faq-a {
    font-size: 15px;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
  }

  /* CTA section */
  .cta-section {
    padding: 100px 0;
    background: linear-gradient(135deg, rgba(102,126,234,0.15) 0%, rgba(118,75,162,0.15) 100%);
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .cta-section h2 {
    font-size: 40px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 16px;
  }

  .cta-section p {
    font-size: 18px;
    color: rgba(255,255,255,0.7);
    margin-bottom: 40px;
  }

  @media (max-width: 900px) {
    .features-grid,
    .pricing-preview-grid {
      grid-template-columns: 1fr;
    }
    .steps {
      flex-direction: column;
      align-items: center;
    }
    .step-arrow {
      transform: rotate(90deg);
      margin: 0;
    }
  }
</style>
