---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const API_URL = import.meta.env.PUBLIC_API_URL;
---

<Layout title="Dashboard" description="Analysez vos patterns émotionnels et suivez votre progression." darkBg={true}>
  <Nav dark={true} />

  <!-- Email gate (shown if not logged in) -->
  <div id="emailGate" class="email-gate hidden">
    <div class="gate-card">
      <div class="gate-icon">🔑</div>
      <h2>Accédez à votre dashboard</h2>
      <p>Entrez l'email de votre abonnement Premium pour voir vos statistiques.</p>
      <div class="input-group" style="margin-top:20px;">
        <input type="email" id="gateEmail" placeholder="votre@email.com" autocomplete="email" />
      </div>
      <button id="gateSubmit" class="btn-primary" style="width:100%;margin-top:8px;">📊 Voir mon dashboard</button>
      <div id="gateStatus" class="status-message hidden"></div>
      <p class="gate-links">
        Pas encore abonné ? <a href="/subscribe">Créer un compte</a> ·
        <a href="/activate">Activer Premium</a>
      </p>
    </div>
  </div>

  <!-- Dashboard content -->
  <div id="dashboardContent" class="hidden">
    <div class="container">
      <header class="dash-header">
        <div>
          <div class="logo-text">⚡ Eumenides Dashboard</div>
          <div id="userEmail" class="user-email"></div>
        </div>
        <div class="period-selector">
          <button class="period-btn" data-days="1">Aujourd'hui</button>
          <button class="period-btn active" data-days="7">Cette semaine</button>
          <button class="period-btn" data-days="30">Ce mois</button>
          <button class="period-btn" data-days="365">Tout</button>
        </div>
      </header>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">🛡️</div>
          <div class="stat-value" id="postsIntercepted">0</div>
          <div class="stat-label">Posts interceptés</div>
          <div class="stat-change" id="weeklyTrendChange">→ 0% vs semaine dernière</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">⏰</div>
          <div class="stat-value" id="timeSaved">0h</div>
          <div class="stat-label">Temps économisé</div>
          <div class="stat-change" id="avgTimePerPost">~0 min par post</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">😌</div>
          <div class="stat-value" id="regretsAvoided">0%</div>
          <div class="stat-label">Regrets évités</div>
          <div class="stat-change" id="calmDaysInfo">0 jours calmes</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🔥</div>
          <div class="stat-value" id="currentStreak">0</div>
          <div class="stat-label">Streak actuel</div>
          <div class="stat-change" id="longestStreak">Record: 0 jours</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">⏰</div>
          <div class="stat-value" id="peakHour">--</div>
          <div class="stat-label">Heure de pointe</div>
          <div class="stat-change" id="peakHourPercent">0% de tes posts</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🏆</div>
          <div class="stat-value" id="bestDayCount">0</div>
          <div class="stat-label">Meilleur jour</div>
          <div class="stat-change" id="bestDayDate">--</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🌡️</div>
          <div class="stat-value" id="angerScore">0.0</div>
          <div class="stat-label">Score de rage</div>
          <div class="stat-change">sur 3.0</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">📅</div>
          <div class="stat-value" id="weekdayPercent">0%</div>
          <div class="stat-label">Posts en semaine</div>
          <div class="stat-change" id="weekendPercent">0% le weekend</div>
        </div>
      </div>

      <div class="chart-section">
        <h2>📊 Activité émotionnelle</h2>
        <canvas id="emotionalActivityChart"></canvas>
      </div>

      <div class="chart-row">
        <div class="chart-section">
          <h2>📱 Répartition par plateforme</h2>
          <canvas id="platformChart" style="max-height:300px"></canvas>
        </div>
        <div class="chart-section">
          <h2>😡 Composition émotionnelle</h2>
          <canvas id="emotionChart" style="max-height:300px"></canvas>
        </div>
      </div>

      <div class="chart-section">
        <h2>⏰ Pattern horaire (24h)</h2>
        <canvas id="hourlyPatternChart"></canvas>
      </div>

      <div class="chart-section">
        <h2>📈 Tendance mensuelle</h2>
        <canvas id="monthlyTrendChart"></canvas>
      </div>

      <div class="chart-section">
        <h2>💡 Insights personnalisés</h2>
        <div class="insights-section" id="insightsList">
          <div class="insight-card">
            <h3>💡 Pattern détecté</h3>
            <p>Commence à utiliser Eumenides pour voir tes patterns de rage posting.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .email-gate {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .gate-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 24px;
    padding: 48px 40px;
    max-width: 460px;
    width: 100%;
    text-align: center;
  }

  .gate-icon { font-size: 56px; margin-bottom: 20px; }

  .gate-card h2 {
    font-size: 26px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .gate-card p {
    font-size: 15px;
    color: rgba(255,255,255,0.7);
    margin-bottom: 4px;
    line-height: 1.6;
  }

  .gate-links {
    margin-top: 20px;
    font-size: 13px;
    color: rgba(255,255,255,0.5);
  }

  .gate-links a { color: #ffd700; text-decoration: none; }
  .gate-links a:hover { text-decoration: underline; }

  /* Dashboard */
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px 0 24px;
    border-bottom: 2px solid rgba(255,255,255,0.08);
    margin-bottom: 36px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .logo-text {
    font-size: 28px;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .user-email {
    font-size: 13px;
    color: rgba(255,255,255,0.45);
    margin-top: 4px;
  }

  .period-selector {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .period-btn {
    padding: 8px 16px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    color: #e0e0e0;
    cursor: pointer;
    transition: 0.2s;
    font-size: 14px;
  }

  .period-btn:hover, .period-btn.active {
    background: rgba(102,126,234,0.3);
    border-color: #667eea;
    color: #fff;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }

  .stat-card {
    background: linear-gradient(135deg, rgba(102,126,234,0.1) 0%, rgba(118,75,162,0.1) 100%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 24px;
    transition: 0.3s;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(102,126,234,0.25);
  }

  .stat-icon { font-size: 30px; margin-bottom: 12px; }

  .stat-value {
    font-size: 34px;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    margin-bottom: 10px;
  }

  .stat-change { font-size: 12px; color: #4ade80; }

  .chart-section {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 28px;
    margin-bottom: 28px;
  }

  .chart-section h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 20px;
    color: #fff;
  }

  .chart-section canvas { width: 100%; height: 300px; border-radius: 8px; }

  .chart-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 28px;
    margin-bottom: 28px;
  }

  .chart-row .chart-section { margin-bottom: 0; }

  .insights-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .insight-card {
    background: rgba(74,222,128,0.08);
    border: 1px solid rgba(74,222,128,0.25);
    border-radius: 12px;
    padding: 18px;
  }

  .insight-card h3 { font-size: 15px; color: #4ade80; margin-bottom: 8px; }
  .insight-card p { font-size: 13px; color: rgba(255,255,255,0.8); line-height: 1.6; }

  @media (max-width: 768px) {
    .dash-header { flex-direction: column; align-items: flex-start; }
    .chart-row { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ API_URL }}>
  let currentPeriodDays = 7;

  function showStatus(el, msg, type) {
    el.textContent = msg;
    el.className = `status-message ${type}`;
    el.classList.remove('hidden');
  }

  // Check if we have an email in localStorage
  const savedEmail = localStorage.getItem('eumenides_email');

  if (savedEmail) {
    initDashboard(savedEmail);
  } else {
    document.getElementById('emailGate').classList.remove('hidden');
  }

  // Gate form submission
  document.getElementById('gateSubmit').addEventListener('click', async function () {
    const email = document.getElementById('gateEmail').value.trim();
    const status = document.getElementById('gateStatus');

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showStatus(status, 'Veuillez entrer une adresse email valide', 'error');
      return;
    }

    this.disabled = true;
    this.textContent = 'Vérification...';

    try {
      const r = await fetch(`${API_URL}/api/check-status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const d = await r.json();

      if (d.premium) {
        localStorage.setItem('eumenides_email', email);
        document.getElementById('emailGate').classList.add('hidden');
        initDashboard(email);
      } else {
        showStatus(status, 'Aucun abonnement actif trouvé pour cet email. <a href="/subscribe" style="color:#ffd700">S\'abonner</a>', 'error');
        this.disabled = false;
        this.textContent = '📊 Voir mon dashboard';
      }
    } catch (e) {
      showStatus(status, 'Erreur réseau. Réessayez.', 'error');
      this.disabled = false;
      this.textContent = '📊 Voir mon dashboard';
    }
  });

  document.getElementById('gateEmail').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') document.getElementById('gateSubmit').click();
  });

  function initDashboard(email) {
    document.getElementById('dashboardContent').classList.remove('hidden');
    document.getElementById('userEmail').textContent = email;

    // Period selector
    document.querySelectorAll('.period-btn').forEach(btn => {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentPeriodDays = parseInt(this.dataset.days);
        loadDashboardData(email);
      });
    });

    loadDashboardData(email);
  }

  async function loadDashboardData(email) {
    try {
      const response = await fetch(`${API_URL}/api/stats`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, days: currentPeriodDays }),
      });

      if (!response.ok) throw new Error(`API error: ${response.status}`);
      const data = await response.json();

      if (data.success) {
        renderAllStats(data);
      }
    } catch (error) {
      console.error('Failed to load stats:', error);
      renderAllStats({ analytics: getEmptyStats(), insights: [], daily: [] });
    }
  }

  function getEmptyStats() {
    return {
      postsIntercepted: 0, timeSavedHours: 0, timeSavedMinutes: 0,
      regretsAvoided: 0, currentStreak: 0, longestStreak: 0,
      weeklyTrend: 0, peakHour: '--', peakHourPercentage: 0,
      bestDay: null, calmDays: 0, angerIntensityScore: 0,
      avgTimePerPost: 0, weekdayPercentage: 0, weekendPercentage: 0,
      platformPercentages: {}, emotionPercentages: {}, hourlyPercentages: {},
    };
  }

  function renderAllStats(data) {
    const { analytics, insights, daily } = data;
    if (!analytics) return;

    document.getElementById('postsIntercepted').textContent = analytics.postsIntercepted || 0;
    document.getElementById('timeSaved').textContent = `${analytics.timeSavedHours || 0}h`;
    document.getElementById('regretsAvoided').textContent = `${analytics.regretsAvoided || 0}%`;
    document.getElementById('currentStreak').textContent = analytics.currentStreak || 0;

    const trend = analytics.weeklyTrend || 0;
    const trendEl = document.getElementById('weeklyTrendChange');
    if (trend > 0) { trendEl.textContent = `↑ ${trend}% vs semaine dernière`; trendEl.style.color = '#ff6b6b'; }
    else if (trend < 0) { trendEl.textContent = `↓ ${Math.abs(trend)}% vs semaine dernière`; trendEl.style.color = '#4ade80'; }
    else { trendEl.textContent = '→ 0% vs semaine dernière'; trendEl.style.color = '#e0e0e0'; }

    document.getElementById('avgTimePerPost').textContent = `~${analytics.avgTimePerPost || 0} min par post`;
    document.getElementById('calmDaysInfo').textContent = `${analytics.calmDays || 0} jours calmes`;
    document.getElementById('longestStreak').textContent = `Record: ${analytics.longestStreak || 0} jours`;
    document.getElementById('peakHour').textContent = analytics.peakHour || '--';
    document.getElementById('peakHourPercent').textContent = `${analytics.peakHourPercentage || 0}% de tes posts`;

    if (analytics.bestDay) {
      document.getElementById('bestDayCount').textContent = analytics.bestDay.count;
      document.getElementById('bestDayDate').textContent = new Date(analytics.bestDay.date)
        .toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
    }

    document.getElementById('angerScore').textContent = analytics.angerIntensityScore || '0.0';
    document.getElementById('weekdayPercent').textContent = `${analytics.weekdayPercentage || 0}%`;
    document.getElementById('weekendPercent').textContent = `${analytics.weekendPercentage || 0}% le weekend`;

    renderEmotionalActivityChart(daily);
    renderPlatformChart(analytics.platformPercentages || {});
    renderEmotionChart(analytics.emotionPercentages || {});
    renderHourlyPatternChart(analytics.hourlyPercentages || {});
    renderMonthlyTrendChart(daily);
    renderInsights(insights || []);
  }

  function setupCanvas(id) {
    const canvas = document.getElementById(id);
    if (!canvas) return null;
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
    return { ctx, width: rect.width, height: rect.height };
  }

  function renderEmotionalActivityChart(dailyData) {
    const c = setupCanvas('emotionalActivityChart');
    if (!c) return;
    const { ctx, width, height } = c;
    ctx.clearRect(0, 0, width, height);

    if (!dailyData || dailyData.length === 0) {
      ctx.fillStyle = 'rgba(255,255,255,0.3)'; ctx.font = '16px -apple-system';
      ctx.textAlign = 'center'; ctx.fillText('Aucune donnée disponible', width / 2, height / 2); return;
    }

    const chartData = dailyData.slice(0, 7).reverse();
    const emotionColors = { anger: '#ff6b6b', frustration: '#ffa500', irritation: '#ffcc00', neutral: '#4ade80' };
    const barWidth = (width / chartData.length) * 0.7;
    const gap = (width / chartData.length) * 0.3;
    const maxValue = Math.max(...chartData.map(d => d.emotions.anger + d.emotions.frustration + d.emotions.irritation + d.emotions.neutral), 1);
    const chartHeight = height - 60;

    chartData.forEach((day, i) => {
      const x = i * (barWidth + gap) + gap / 2;
      const total = day.emotions.anger + day.emotions.frustration + day.emotions.irritation + day.emotions.neutral;
      let yOffset = chartHeight;

      if (total === 0) {
        ctx.fillStyle = 'rgba(255,255,255,0.05)'; ctx.fillRect(x, 40, barWidth, chartHeight - 40);
      } else {
        ['neutral', 'irritation', 'frustration', 'anger'].forEach(emotion => {
          const val = day.emotions[emotion] || 0;
          const bh = (val / maxValue) * (chartHeight - 40);
          if (bh > 0) { ctx.fillStyle = emotionColors[emotion]; ctx.fillRect(x, yOffset - bh, barWidth, bh); yOffset -= bh; }
        });
      }

      const date = new Date(day.date);
      const label = i === chartData.length - 1 ? 'Auj.' : date.toLocaleDateString('fr-FR', { weekday: 'short' });
      ctx.fillStyle = '#e0e0e0'; ctx.font = '12px -apple-system'; ctx.textAlign = 'center';
      ctx.fillText(label, x + barWidth / 2, height - 10);
      if (total > 0) { ctx.fillStyle = '#e0e0e0'; ctx.font = 'bold 14px -apple-system'; ctx.fillText(total.toString(), x + barWidth / 2, yOffset - 5); }
    });

    const legendItems = [
      { key: 'anger', label: 'Colère' }, { key: 'frustration', label: 'Frustration' },
      { key: 'irritation', label: 'Irritation' }, { key: 'neutral', label: 'Neutre' },
    ];
    let legendX = 10;
    legendItems.forEach(e => {
      ctx.fillStyle = emotionColors[e.key]; ctx.fillRect(legendX, 10, 12, 12);
      ctx.fillStyle = '#e0e0e0'; ctx.font = '11px -apple-system'; ctx.textAlign = 'left';
      ctx.fillText(e.label, legendX + 16, 20);
      legendX += ctx.measureText(e.label).width + 32;
    });
  }

  function renderPieChart(canvasId, items, percentages) {
    const c = setupCanvas(canvasId);
    if (!c) return;
    const { ctx, width, height } = c;
    ctx.clearRect(0, 0, width, height);

    const total = Object.values(percentages).reduce((s, v) => s + v, 0);
    if (total === 0) {
      ctx.fillStyle = 'rgba(255,255,255,0.3)'; ctx.font = '14px -apple-system';
      ctx.textAlign = 'center'; ctx.fillText('Aucune donnée disponible', width / 2, height / 2); return;
    }

    const cx = width / 3, cy = height / 2, r = Math.min(width / 3, height / 2) * 0.8;
    let angle = -Math.PI / 2;
    items.forEach(item => {
      const pct = percentages[item.key] || 0;
      if (pct > 0) {
        const slice = (pct / 100) * 2 * Math.PI;
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.arc(cx, cy, r, angle, angle + slice); ctx.closePath();
        ctx.fillStyle = item.color; ctx.fill(); angle += slice;
      }
    });

    let ly = cy - (items.length * 30) / 2;
    const lx = width * 0.6;
    items.forEach(item => {
      const pct = percentages[item.key] || 0;
      ctx.fillStyle = item.color; ctx.fillRect(lx, ly, 14, 14);
      ctx.fillStyle = '#e0e0e0'; ctx.font = '13px -apple-system'; ctx.textAlign = 'left';
      ctx.fillText(`${item.label}${pct > 0 ? ': ' + pct + '%' : ''}`, lx + 20, ly + 12);
      ly += 30;
    });
  }

  function renderPlatformChart(percentages) {
    renderPieChart('platformChart', [
      { key: 'twitter', label: 'Twitter', color: '#1DA1F2' },
      { key: 'reddit', label: 'Reddit', color: '#FF4500' },
      { key: 'facebook', label: 'Facebook', color: '#1877F2' },
      { key: 'linkedin', label: 'LinkedIn', color: '#0A66C2' },
    ], percentages);
  }

  function renderEmotionChart(percentages) {
    renderPieChart('emotionChart', [
      { key: 'anger', label: 'Colère', color: '#ff6b6b' },
      { key: 'frustration', label: 'Frustration', color: '#ffa500' },
      { key: 'irritation', label: 'Irritation', color: '#ffcc00' },
      { key: 'neutral', label: 'Neutre', color: '#4ade80' },
    ], percentages);
  }

  function renderHourlyPatternChart(hourlyPercentages) {
    const c = setupCanvas('hourlyPatternChart');
    if (!c) return;
    const { ctx, width, height } = c;
    ctx.clearRect(0, 0, width, height);

    const hours = [
      { key: '00-05', label: '00h-05h' }, { key: '06-11', label: '06h-11h' },
      { key: '12-17', label: '12h-17h' }, { key: '18-23', label: '18h-23h' },
    ];
    const maxPct = Math.max(...Object.values(hourlyPercentages), 1);
    const barWidth = (width / hours.length) * 0.7;
    const gap = (width / hours.length) * 0.3;
    const chartHeight = height - 60;

    hours.forEach((hour, i) => {
      const pct = hourlyPercentages[hour.key] || 0;
      const bh = (pct / maxPct) * (chartHeight - 40);
      const x = i * (barWidth + gap) + gap / 2;
      const y = chartHeight - bh;
      const grad = ctx.createLinearGradient(0, y, 0, chartHeight);
      grad.addColorStop(0, '#667eea'); grad.addColorStop(1, '#764ba2');
      ctx.fillStyle = grad; ctx.fillRect(x, y, barWidth, bh);
      if (pct > 0) { ctx.fillStyle = '#e0e0e0'; ctx.font = 'bold 14px -apple-system'; ctx.textAlign = 'center'; ctx.fillText(`${pct}%`, x + barWidth / 2, y - 10); }
      ctx.fillStyle = '#e0e0e0'; ctx.font = '12px -apple-system'; ctx.textAlign = 'center';
      ctx.fillText(hour.label, x + barWidth / 2, height - 10);
    });
  }

  function renderMonthlyTrendChart(dailyData) {
    const c = setupCanvas('monthlyTrendChart');
    if (!c) return;
    const { ctx, width, height } = c;
    ctx.clearRect(0, 0, width, height);

    if (!dailyData || dailyData.length === 0) {
      ctx.fillStyle = 'rgba(255,255,255,0.3)'; ctx.font = '14px -apple-system';
      ctx.textAlign = 'center'; ctx.fillText('Aucune donnée disponible', width / 2, height / 2); return;
    }

    const weeks = Math.min(Math.ceil(dailyData.length / 7), 12);
    const weeklyData = [];
    for (let i = 0; i < weeks; i++) {
      const wd = dailyData.slice(i * 7, (i + 1) * 7);
      weeklyData.push({ week: weeks - i, total: wd.reduce((s, d) => s + (d.posts || 0), 0), date: wd[0]?.date });
    }
    weeklyData.reverse();

    const maxPosts = Math.max(...weeklyData.map(w => w.total), 1);
    const spacing = width / (weeklyData.length + 1);
    const chartHeight = height - 60;

    ctx.beginPath(); ctx.strokeStyle = '#667eea'; ctx.lineWidth = 3;
    weeklyData.forEach((week, i) => {
      const x = (i + 1) * spacing;
      const y = chartHeight - (week.total / maxPosts) * (chartHeight - 40);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      ctx.fillStyle = '#667eea'; ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#e0e0e0'; ctx.font = 'bold 12px -apple-system'; ctx.textAlign = 'center';
      ctx.fillText(week.total.toString(), x, y - 10);
      if (week.date) {
        const label = new Date(week.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        ctx.font = '11px -apple-system'; ctx.fillText(label, x, height - 10);
      }
    });
    ctx.stroke();
  }

  function renderInsights(insights) {
    const container = document.getElementById('insightsList');
    if (!container) return;

    if (!insights || insights.length === 0) {
      container.innerHTML = `<div class="insight-card"><h3>💡 Insights personnalisés</h3><p>Commence à utiliser Eumenides pour voir tes patterns et insights personnalisés.</p></div>`;
      return;
    }

    const typeLabels = { pattern: 'Pattern détecté', emotion: 'Composition émotionnelle', platform: 'Plateforme déclencheur', improvement: 'Amélioration', achievement: 'Achievement' };
    container.innerHTML = insights.map(i => `
      <div class="insight-card">
        <h3>${i.icon || '💡'} ${typeLabels[i.type] || 'Insight'}</h3>
        <p>${i.message}</p>
      </div>`).join('');
  }
</script>
