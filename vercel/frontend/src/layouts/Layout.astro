---
interface Props {
  title: string;
  description?: string;
  darkBg?: boolean;
}

const {
  title,
  description = "Transformez votre rage en sagesse. Postez sans regrets.",
  darkBg = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Eumenides</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#667eea" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} — Eumenides`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class={darkBg ? "dark-body" : ""}>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  .dark-body {
    background: #0f0f23;
  }
</style>
