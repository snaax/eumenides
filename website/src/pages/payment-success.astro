---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Paiement réussi" description="Votre abonnement Eumenides a été activé avec succès.">
  <div class="page-gradient">
    <div class="success-container">
      <div class="success-icon">🎉</div>
      <h1>Paiement réussi !</h1>
      <p class="subtitle">Votre abonnement Eumenides Premium est actif.</p>

      <div class="steps-card">
        <h2>🔑 Activez l'extension</h2>
        <p>Vous allez recevoir un email avec un <strong>code d'activation à 6 chiffres</strong>.<br />Suivez ces étapes pour activer Premium dans l'extension :</p>
        <ol class="activation-steps">
          <li>
            <span class="step-num">1</span>
            <span>Ouvrez votre email et copiez le <strong>code à 6 chiffres</strong></span>
          </li>
          <li>
            <span class="step-num">2</span>
            <span>Cliquez sur l'icône Eumenides dans votre barre d'outils Chrome</span>
          </li>
          <li>
            <span class="step-num">3</span>
            <span>Cliquez sur <strong>"✨ Passer à Premium"</strong> → <strong>"Activer Premium"</strong></span>
          </li>
          <li>
            <span class="step-num">4</span>
            <span>Entrez votre email et le code reçu</span>
          </li>
        </ol>
      </div>

      <div class="divider-text">— ou —</div>

      <p class="alt-text">Vous pouvez aussi accéder à votre dashboard ici directement.<br />Entrez votre email pour vous identifier.</p>

      <div class="email-form">
        <input type="email" id="emailInput" placeholder="votre@email.com" autocomplete="email" />
        <button id="goToDashboard" class="btn-primary" style="width:100%;margin-top:12px;">📊 Voir mon dashboard</button>
      </div>

      <div class="footer-links">
        <a href="/activate">Activer sur un autre appareil</a>
        <span>·</span>
        <a href="/account">Gérer mon abonnement</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-gradient {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .success-container {
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(12px);
    border-radius: 24px;
    padding: 48px 40px;
    max-width: 540px;
    width: 100%;
    text-align: center;
  }

  .success-icon {
    font-size: 72px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: 36px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 16px;
    color: rgba(255,255,255,0.85);
    margin-bottom: 32px;
  }

  .steps-card {
    background: rgba(0,0,0,0.25);
    border-radius: 16px;
    padding: 28px;
    text-align: left;
    margin-bottom: 24px;
  }

  .steps-card h2 {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .steps-card p {
    font-size: 14px;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .activation-steps {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .activation-steps li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 14px;
    color: rgba(255,255,255,0.9);
    line-height: 1.5;
  }

  .step-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea, #764ba2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
  }

  .divider-text {
    color: rgba(255,255,255,0.4);
    font-size: 13px;
    margin: 20px 0 16px;
  }

  .alt-text {
    font-size: 14px;
    color: rgba(255,255,255,0.75);
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .email-form input {
    width: 100%;
    padding: 13px 16px;
    border: 2px solid rgba(255,255,255,0.25);
    border-radius: 10px;
    background: rgba(255,255,255,0.15);
    color: #fff;
    font-size: 16px;
    font-family: inherit;
  }

  .email-form input::placeholder {
    color: rgba(255,255,255,0.5);
  }

  .email-form input:focus {
    outline: none;
    border-color: #ffd700;
  }

  .footer-links {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    gap: 12px;
    font-size: 14px;
    color: rgba(255,255,255,0.5);
  }

  .footer-links a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #ffd700;
    text-decoration: underline;
  }
</style>

<script>
  // Pre-fill email from localStorage if available
  const savedEmail = localStorage.getItem('eumenides_email');
  if (savedEmail) {
    document.getElementById('emailInput').value = savedEmail;
  }

  document.getElementById('goToDashboard').addEventListener('click', function () {
    const email = document.getElementById('emailInput').value.trim();
    if (!email) {
      document.getElementById('emailInput').style.borderColor = '#ef4444';
      return;
    }
    localStorage.setItem('eumenides_email', email);
    window.location.href = '/dashboard';
  });
</script>
